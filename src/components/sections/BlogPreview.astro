---
import { getCollection } from "astro:content";
import { motion } from "framer-motion";

const allPosts = await getCollection("blog");
const latestPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  }).format(date);
---

<section class="w-full px-6 tablet:px-24 py-16 bg-white">
  {/* Header */}
  <div class="flex flex-col tablet:flex-row tablet:items-end justify-between gap-4 mb-12">
    <div>
      <span class="text-xs font-mono font-semibold uppercase tracking-widest text-blue-500 mb-3 block">
        // Stories
      </span>
      <h2 class="text-5xl tablet:text-7xl font-black tracking-tighter text-gray-900 leading-none">
        Latest<br />
        <span class="text-blue-500 drop-shadow-[0_8px_16px_rgba(59,130,246,0.3)]">
          Insights
        </span>
      </h2>
    </div>
    <a
      href="/blogs"
      class="inline-flex items-center gap-2 text-xs font-mono font-bold uppercase tracking-wider text-gray-400 hover:text-blue-500 transition-colors group"
    >
      All Articles
      <span class="group-hover:translate-x-1 transition-transform duration-200">→</span>
    </a>
  </div>

  {/* Posts Grid */}
  <div class="grid grid-cols-1 tablet:grid-cols-2 desktop:grid-cols-3 gap-5">
    {latestPosts.map((post, idx) => (
      <a
        href={`/blog/${post.slug}`}
        class="group flex flex-col border border-gray-100 rounded-xl overflow-hidden bg-gray-50 hover:bg-white hover:border-blue-100 hover:shadow-xl hover:shadow-blue-400/8 hover:-translate-y-1 transition-all duration-300"
        style={`animation-delay: ${idx * 100}ms`}
      >
        {/* Hero Image */}
        {post.data.heroImage && (
          <div class="h-44 w-full overflow-hidden flex-shrink-0">
            <img
              src={post.data.heroImage}
              alt={post.data.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
          </div>
        )}

        {/* Content */}
        <div class="flex flex-col flex-1 p-6 gap-3">
          {/* Meta */}
          <div class="flex items-center gap-3">
            <time class="text-[10px] font-mono uppercase tracking-widest text-gray-400">
              {formatDate(post.data.pubDate)}
            </time>
          </div>

          {/* Title */}
          <h3 class="text-base font-black tracking-tight text-gray-900 leading-snug group-hover:text-blue-600 transition-colors line-clamp-2">
            {post.data.title}
          </h3>

          {/* Description */}
          <p class="text-sm font-mono text-gray-500 leading-relaxed line-clamp-2 flex-1">
            {post.data.description}
          </p>

          {/* Tags + Arrow */}
          <div class="flex items-center justify-between pt-4 border-t border-gray-100 mt-auto">
            <div class="flex flex-wrap gap-1.5">
              {post.data.tags.slice(0, 2).map((tag: string) => (
                <span class="text-[10px] font-mono font-bold uppercase tracking-wider text-gray-500 bg-gray-100 group-hover:bg-blue-50 group-hover:text-blue-600 border border-gray-200 group-hover:border-blue-100 px-2 py-0.5 rounded-full transition-all duration-200">
                  #{tag}
                </span>
              ))}
            </div>
            <span class="w-8 h-8 rounded-full bg-gray-900 group-hover:bg-blue-500 flex items-center justify-center text-white text-sm transition-all duration-300 flex-shrink-0 group-hover:translate-x-0.5">
              →
            </span>
          </div>
        </div>
      </a>
    ))}
  </div>
</section>
