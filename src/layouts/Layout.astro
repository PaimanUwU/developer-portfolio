---
import "../styles/global.css";
import LoadingScreen from "../components/LoadingScreen.tsx";
import Navbar from "../components/Navbar.tsx";
import MobileMenu from "../components/MobileMenu.tsx";
import Footer from "../components/sections/Footer.tsx";
import CustomCursor from "../components/CustomCursor.tsx";
import SmoothScroll from "../components/SmoothScroll.tsx";
import { ClientRouter } from 'astro:transitions'; // 1. Import Router

const pathname = Astro.url.pathname;

interface Props {
  title?: string;
  home?: boolean;
}

const { home, title = "PaimanUwU" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/Icon Light.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Funnel+Display:wght@300..800&family=Funnel+Sans:ital,wght@0,300..800;1,300..800&family=JetBrains+Mono:wght@300;400;500;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
   
    <ClientRouter /> 
  </head>
  <body class="bg-white text-black overflow-x-hidden">
    <LoadingScreen client:load transition:persist />
    <CustomCursor client:load transition:persist />
    <SmoothScroll client:load />

    <div class="absolute z-30 top-0 h-full w-fit flex-none">
      <Navbar client:load transition:persist currentPath={pathname} home={home} />
    </div>

    <MobileMenu client:load transition:persist currentPath={pathname} />

    <main class={`relative w-full top-0 z-0 min-h-screen ${home ? '' : 'desktop:pl-20'}`}>
      {!home && <span class="p-4 mb-2 font-mono text-sm text-gray-500 block">-// {title}</span>}
      <slot />
    </main>
    <Footer client:load transition:persist />

    <script>
      // Disable browser scroll restoration so we always control position
      if ("scrollRestoration" in history) {
        history.scrollRestoration = "manual";
      }

      function scrollToTop() {
        window.scrollTo(0, 0);
        document.documentElement.scrollTop = 0;
        document.body.scrollTop = 0;
      }

      // astro:before-swap — earliest hook, fires before DOM swap
      // This is critical: sets window.scrollY = 0 BEFORE Lenis is reconstructed
      document.addEventListener("astro:before-swap", scrollToTop);

      // astro:after-swap — fires after new DOM is inserted, safety net
      document.addEventListener("astro:after-swap", scrollToTop);

      // astro:page-load — fires after full hydration, catches the initial load
      document.addEventListener("astro:page-load", scrollToTop);
    </script>
  </body>
</html>
